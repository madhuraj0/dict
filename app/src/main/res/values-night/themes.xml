<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Dark application theme. -->
    <style name="Theme.Dict" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/md_theme_dark_primary</item>
        <item name="colorOnPrimary">@color/md_theme_dark_onPrimary</item>
        <item name="colorPrimaryContainer">@color/md_theme_dark_primaryContainer</item>
        <item name="colorOnPrimaryContainer">@color/md_theme_dark_onPrimaryContainer</item>
        <item name="colorSecondary">@color/md_theme_dark_secondary</item>
        <item name="colorSecondaryContainer">@color/md_theme_dark_secondaryContainer</item>
        <item name="android:colorBackground">@color/md_theme_dark_background</item>
        <item name="colorSurface">@color/md_theme_dark_surface</item>
        <item name="colorOnSurface">@color/md_theme_dark_onSurface</item>
        <item name="colorOutlineVariant">@color/md_theme_dark_outlineVariant</item>
    </style>

    <style name="Theme.Dict.Translucent" parent="Theme.Dict">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:backgroundDimAmount">0.6</item>
        <item name="android:windowAnimationStyle">@android:style/Animation.Dialog</item>
    </style>

    <!-- AMOLED Pitch Black Base Themes (Dark) -->
    <style name="Theme.Dict.Amoled" parent="Theme.Dict">
        <item name="android:colorBackground">@color/amoled_background</item>
        <item name="colorSurface">@color/amoled_surface</item>
        <item name="colorOnSurface">@color/amoled_onSurface</item>
        <item name="colorOutlineVariant">@color/amoled_outlineVariant</item>
    </style>

    <style name="Theme.Dict.Translucent.Amoled" parent="Theme.Dict.Translucent">
        <item name="android:colorBackground">@color/amoled_background</item>
        <item name="colorSurface">@color/amoled_surface</item>
        <item name="colorOnSurface">@color/amoled_onSurface</item>
        <item name="colorOutlineVariant">@color/amoled_outlineVariant</item>
    </style>

    <!-- Accent Theme Overlays (Dark) -->
    <style name="ThemeOverlay.Dict.Amber">
        <item name="colorPrimary">@color/amber_dark_primary</item>
        <item name="colorOnPrimary">@color/amber_dark_onPrimary</item>
        <item name="colorPrimaryContainer">@color/amber_dark_primaryContainer</item>
        <item name="colorOnPrimaryContainer">@color/amber_dark_onPrimaryContainer</item>
    </style>

    <style name="ThemeOverlay.Dict.Blue">
        <item name="colorPrimary">@color/blue_dark_primary</item>
        <item name="colorOnPrimary">@color/blue_dark_onPrimary</item>
        <item name="colorPrimaryContainer">@color/blue_dark_primaryContainer</item>
        <item name="colorOnPrimaryContainer">@color/blue_dark_onPrimaryContainer</item>
    </style>

    <style name="ThemeOverlay.Dict.Emerald">
        <item name="colorPrimary">@color/emerald_dark_primary</item>
        <item name="colorOnPrimary">@color/emerald_dark_onPrimary</item>
        <item name="colorPrimaryContainer">@color/emerald_dark_primaryContainer</item>
        <item name="colorOnPrimaryContainer">@color/emerald_dark_onPrimaryContainer</item>
    </style>

    <style name="ThemeOverlay.Dict.Crimson">
        <item name="colorPrimary">@color/crimson_dark_primary</item>
        <item name="colorOnPrimary">@color/crimson_dark_onPrimary</item>
        <item name="colorPrimaryContainer">@color/crimson_dark_primaryContainer</item>
        <item name="colorOnPrimaryContainer">@color/crimson_dark_onPrimaryContainer</item>
    </style>

    <style name="ThemeOverlay.Dict.Monochrome">
        <item name="colorPrimary">@color/mono_dark_primary</item>
        <item name="colorOnPrimary">@color/mono_dark_onPrimary</item>
        <item name="colorPrimaryContainer">@color/mono_dark_primaryContainer</item>
        <item name="colorOnPrimaryContainer">@color/mono_dark_onPrimaryContainer</item>
    </style>
</resources>
